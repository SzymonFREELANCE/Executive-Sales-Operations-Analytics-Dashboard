model Model
	culture: pl-PL
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Fact_Sales","Dim_Customer","Dim_Category","Dim_Payment","_Measures","DatasetFilePath"]

annotation PBI_ProTooling = ["DevMode"]

ref table Fact_Sales
ref table Dim_Calendar
ref table Dim_Customer
ref table Dim_Category
ref table Dim_Payment
ref table _Measures
ref table 'Date Granularity'

ref role Regional_Manager_North
ref role Regional_Manager_East
ref role Regional_Manager_South
ref role Regional_Manager_West

ref cultureInfo pl-PL


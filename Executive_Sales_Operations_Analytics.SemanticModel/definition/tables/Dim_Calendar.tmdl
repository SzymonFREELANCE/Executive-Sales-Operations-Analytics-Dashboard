	column 'Year Quarter'
		lineageTag: afe0f199-52de-40c5-935e-496217db1782
		summarizeBy: none
		sourceColumn: [YearQuarter]

		annotation SummarizationSetBy = Automatic

	column 'Year Quarter Sort'
		isHidden
		formatString: 0
		lineageTag: f494905b-4e03-44e6-9a2a-010baa4cecee
		summarizeBy: none
		sourceColumn: [YearQuarterSort]

		annotation SummarizationSetBy = Automatic

	partition Dim_Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDARAUTO(),
				    "Year", YEAR([Date]),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "MonthNo", MONTH([Date]),
				    "MonthName", FORMAT([Date], "mmm", "en-US"),
				    "YearMonth", FORMAT([Date], "mmm yy", "en-US"),
				    "YearMonthSort", YEAR([Date]) * 100 + MONTH([Date]),
				    "YearQuarter", YEAR([Date]) & " Q" & FORMAT([Date], "Q"),
				    "YearQuarterSort", YEAR([Date]) * 10 + INT(FORMAT([Date], "Q"))
				)

	annotation PBI_Id = 63a4a9e75d8d401aacfe7063f2d6f812


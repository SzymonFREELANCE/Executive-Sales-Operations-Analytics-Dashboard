	column Quarter
		lineageTag: 9fed5d7a-0893-4218-98bb-fae7cf95df5a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

		annotation SummarizationSetBy = Automatic

	column 'Month No'
		formatString: 0
		lineageTag: a251a465-af37-45f1-b821-5def8804a6aa
		summarizeBy: none
		sourceColumn: [MonthNo]

		annotation SummarizationSetBy = User

	column 'Month Name'
		lineageTag: 30770aa9-5732-4a15-87c5-86494e8393a7
		summarizeBy: none

	column 'Gross Profit' = 'Fact_Sales'[Revenue] - ('Fact_Sales'[Quantity] * 'Fact_Sales'[Unit Price] * 0.6)
		isHidden
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00

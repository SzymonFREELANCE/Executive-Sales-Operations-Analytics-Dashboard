		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column 'Discount Group' =
			
			SWITCH(
			    TRUE(),
			    Fact_Sales[Discount] < 0.10, "0-10%",
			    Fact_Sales[Discount] <= 0.20, "10-20%",
			    "20%+"
			)
		isHidden
		lineageTag: e4b8a41e-29c5-40c5-a119-5fa11339303e
		summarizeBy: none
		sortByColumn: 'Discount Group Sort'

		changedProperty = SortByColumn

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	column 'Discount Group Sort' =
			
			SWITCH(
			    TRUE(),
			    Fact_Sales[Discount] < 0.10, 1,
			    Fact_Sales[Discount] <= 0.20, 2,
			    3
			)
		isHidden

	measure 'Rating YoY Formatted' =
			
			VAR SelectedYear = SELECTEDVALUE('Dim_Calendar'[Year])
			VAR MaxSalesYear = YEAR(CALCULATE(MAX('Fact_Sales'[Order Date]), ALLSELECTED('Fact_Sales')))
			VAR TargetYear = COALESCE(SelectedYear, MaxSalesYear)
			
			VAR CurrentRating = CALCULATE(AVERAGE('Fact_Sales'[Customer Rating]), 'Dim_Calendar'[Year] = TargetYear)
			VAR PreviousRating = CALCULATE(AVERAGE('Fact_Sales'[Customer Rating]), 'Dim_Calendar'[Year] = TargetYear - 1)
			
			VAR Diff = CurrentRating - PreviousRating
			VAR YearLabel = IF(ISBLANK(SelectedYear), " (" & TargetYear & " vs " & (TargetYear - 1) & ")", " vs PY")
			
			RETURN
			IF(
			    ISBLANK(Diff),
			    "",
			    SWITCH(
			        TRUE(),
			        ABS(Diff) < 0.05, "► 0.0" & YearLabel,
			        Diff > 0, "▲ " & FORMAT(Diff, "0.0", "en-US") & YearLabel,
			        "▼ " & FORMAT(ABS(Diff), "0.0", "en-US") & YearLabel
			    )
			)
		displayFolder: 02_YoY Logic
		lineageTag: 270bec58-bc5f-4eab-aa36-07c737ebfab8

	measure 'Delivery YoY Formatted' =
			
			VAR SelectedYear = SELECTEDVALUE('Dim_Calendar'[Year])
			VAR MaxSalesYear = YEAR(CALCULATE(MAX('Fact_Sales'[Order Date]), ALLSELECTED('Fact_Sales')))
			VAR TargetYear = COALESCE(SelectedYear, MaxSalesYear)
			
			VAR CurrentDays = CALCULATE(AVERAGE('Fact_Sales'[Delivery Days]), 'Dim_Calendar'[Year] = TargetYear)
			VAR PreviousDays = CALCULATE(AVERAGE('Fact_Sales'[Delivery Days]), 'Dim_Calendar'[Year] = TargetYear - 1)
			
			VAR Diff = CurrentDays - PreviousDays
			VAR YearLabel = IF(ISBLANK(SelectedYear), " (" & TargetYear & " vs " & (TargetYear - 1) & ")", " vs PY")
			
			RETURN
			IF(
			    ISBLANK(Diff),
			    "",
			    SWITCH(
			        TRUE(),
			        ABS(Diff) < 0.05, "► 0.0 days" & YearLabel,
			        Diff < 0, "▼ " & FORMAT(ABS(Diff), "0.0", "en-US") & " days" & YearLabel,
			        "▲ " & FORMAT(ABS(Diff), "0.0", "en-US") & " days" & YearLabel
			    )
			)
		displayFolder: 02_YoY Logic
		lineageTag: b85cea2b-d121-477d-bdbd-3bde1710910d


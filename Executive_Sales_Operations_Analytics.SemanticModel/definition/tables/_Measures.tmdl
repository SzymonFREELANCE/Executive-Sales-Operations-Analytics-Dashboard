	measure 'AOV YoY Formatted' =
			
			VAR SelectedYear = SELECTEDVALUE('Dim_Calendar'[Year])
			VAR MaxSalesYear = YEAR(CALCULATE(MAX('Fact_Sales'[Order Date]), ALLSELECTED('Fact_Sales')))
			VAR TargetYear = COALESCE(SelectedYear, MaxSalesYear)
			
			VAR CurrentAOV = CALCULATE([Average Order Value], 'Dim_Calendar'[Year] = TargetYear)
			VAR PreviousAOV = CALCULATE([Average Order Value], 'Dim_Calendar'[Year] = TargetYear - 1)
			
			VAR YoY = DIVIDE(CurrentAOV - PreviousAOV, PreviousAOV, BLANK())
			VAR YearLabel = IF(ISBLANK(SelectedYear), " (" & TargetYear & " vs " & (TargetYear - 1) & ")", " YoY")
			
			RETURN
			IF(
			    ISBLANK(YoY),
			    "",
			    SWITCH(
			        TRUE(),
			        ABS(YoY) < 0.0005, "► 0.0%" & YearLabel,
			        YoY > 0, "▲ " & FORMAT(YoY, "0.0%", "en-US") & YearLabel,
			        "▼ " & FORMAT(ABS(YoY), "0.0%", "en-US") & YearLabel
			    )
			)
		displayFolder: 02_YoY Logic
		lineageTag: 66070d4e-322d-4fae-8803-f2d7ca77ed8b

	measure 'Profit Margin YoY Formatted' =
			
			VAR SelectedYear = SELECTEDVALUE('Dim_Calendar'[Year])
			VAR MaxSalesYear = YEAR(CALCULATE(MAX('Fact_Sales'[Order Date]), ALLSELECTED('Fact_Sales')))
			VAR TargetYear = COALESCE(SelectedYear, MaxSalesYear)
			
			VAR CurrentMargin = CALCULATE([Profit Margin], 'Dim_Calendar'[Year] = TargetYear)
			VAR PreviousMargin = CALCULATE([Profit Margin], 'Dim_Calendar'[Year] = TargetYear - 1)
			
			-- Считаем разницу в процентных пунктах
			VAR MarginDiff = CurrentMargin - PreviousMargin
			VAR YearLabel = IF(ISBLANK(SelectedYear), " (" & TargetYear & " vs " & (TargetYear - 1) & ")", " YoY")
			
			RETURN
			IF(
			    ISBLANK(MarginDiff),
			    "",
			    SWITCH(
			        TRUE(),
			        ABS(MarginDiff) < 0.0005, "► 0.0%" & YearLabel,
			        MarginDiff > 0, "▲ " & FORMAT(MarginDiff, "0.0%", "en-US") & YearLabel,
			        "▼ " & FORMAT(ABS(MarginDiff), "0.0%", "en-US") & YearLabel
			    )
			)
		displayFolder: 02_YoY Logic
		lineageTag: ff772fce-9c6d-4f6b-a899-375ec174d6e2

	measure 'Avg Discount YoY Formatted' =
			
			VAR SelectedYear = SELECTEDVALUE('Dim_Calendar'[Year])
			VAR MaxSalesYear = YEAR(CALCULATE(MAX('Fact_Sales'[Order Date]), ALLSELECTED('Fact_Sales')))
			VAR TargetYear = COALESCE(SelectedYear, MaxSalesYear)
			
			VAR CurrentDiscount = CALCULATE([Average Discount], 'Dim_Calendar'[Year] = TargetYear)
			VAR PreviousDiscount = CALCULATE([Average Discount], 'Dim_Calendar'[Year] = TargetYear - 1)
			
			VAR DiscountDiff = CurrentDiscount - PreviousDiscount
			VAR YearLabel = IF(ISBLANK(SelectedYear), " (" & TargetYear & " vs " & (TargetYear - 1) & ")", " YoY")
			
			RETURN
			IF(
			    ISBLANK(DiscountDiff),
			    "",
			    SWITCH(
			        TRUE(),
			        ABS(DiscountDiff) < 0.0005, "► 0.0%" & YearLabel,
			        DiscountDiff > 0, "▲ " & FORMAT(DiscountDiff, "0.0%", "en-US") & YearLabel,
			        "▼ " & FORMAT(ABS(DiscountDiff), "0.0%", "en-US") & YearLabel
			    )
			)
		displayFolder: 02_YoY Logic
		lineageTag: c4d11340-689e-4c1c-9a22-58f0a1abb3e7

